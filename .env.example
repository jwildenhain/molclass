# Create an untracked .env file and replace both secrets before starting compose.
MOLCLASS_DB_ROOT_PASSWORD=replace-with-a-long-random-root-secret
MOLCLASS_DB_USER=molclass_app
MOLCLASS_DB_PASSWORD=replace-with-a-long-random-application-secret

MOLCLASS_INNODB_BUFFER_POOL=8G
MOLCLASS_PREDICTOR_MEMORY=6g
MOLCLASS_FRONTEND_MEMORY=1g
MOLCLASS_PREDICTOR_PORT=8082
MOLCLASS_FRONTEND_PORT=3000
MOLCLASS_API_MEMORY=1g
MOLCLASS_SDF_WORKER_MEMORY=2g
MOLCLASS_API_PORT=8000
MOLCLASS_MODEL_WORKER_MEMORY=16g
MOLCLASS_MODEL_THREADS=8
MOLCLASS_MODEL_POLL_SECONDS=30
MOLCLASS_FEATURE_TIMEOUT_MINUTES=30
MOLCLASS_MODEL_TIMEOUT_MINUTES=60
MOLCLASS_CODE_REVISION=replace-with-immutable-revision
